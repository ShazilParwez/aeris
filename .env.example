# AERIS Environment Configuration

# -------------------------------------------------------------
# Google Gemini API Credentials (Backend Only)
# Optional: If not provided, AERIS runs in high-fidelity deterministic expert mode.
# -------------------------------------------------------------
GEMINI_API_KEY=

# Gemini model identifier (Defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend API server configuration
API_PORT=8000
API_HOST=127.0.0.1

# Frontend API URL configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
